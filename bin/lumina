#!/usr/bin/env php
<?php
/**
 * Lumina CLI - Motor de Comprensión de Código
 *
 * Uso:
 *   ./bin/lumina analyze <project_path> [project_id]
 *   ./bin/lumina populate [project_id]
 *   ./bin/lumina dossier <file_path>
 *   ./bin/lumina graph <project_id>
 */

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Lumina\Core\Lumina;
use Lumina\Core\Config;

// Banner
echo "\n";
echo "╔══════════════════════════════════════════╗\n";
echo "║  LUMINA - Motor de Comprensión de Código ║\n";
echo "║  v1.0.0 | Apache 2.0 License              ║\n";
echo "╚══════════════════════════════════════════╝\n\n";

$command = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

$config = Config::load();
$lumina = new Lumina($config);

match ($command) {
    'analyze' => (function() use ($lumina, $args) {
        $path = $args[0] ?? '.';
        $projectId = (int)($args[1] ?? 1);
        $lumina->analyzeProject($path, $projectId);
    })(),
    'populate' => (function() use ($lumina, $args) {
        $projectId = (int)($args[0] ?? 1);
        $lumina->populateRelations($projectId);
    })(),
    'dossier' => (function() use ($lumina, $args) {
        $file = $args[0] ?? '';
        $projectId = (int)($args[1] ?? 1);
        
        if (empty($file)) {
            echo "Error: Debes especificar un archivo o usar 'all' para todos\n";
            echo "Uso: ./bin/lumina dossier <archivo|all> [project_id]\n";
            return;
        }
        
        if ($file === 'all') {
            $lumina->generateDossiers($projectId);
        } else {
            $generator = new \Lumina\Dossier\DossierGenerator($lumina->getDb());
            $result = $generator->generateForFile($file, $projectId);
            
            if ($result['success']) {
                echo "✅ Dossier generado para: {$file}\n";
                echo "📁 Guardado en: dossiers/\n";
            } else {
                echo "❌ Error: {$result['error']}\n";
            }
        }
    })(),
    'graph' => $lumina->showGraph((int)($args[0] ?? 0)),
    'help', '--help', '-h' => showHelp(),
    default => showHelp(),
};

function showHelp(): void
{
    echo "Comandos disponibles:\n";
    echo "  analyze <path> [project_id]     Analiza un proyecto PHP (extrae chunks)\n";
    echo "  populate [project_id]           Construye el grafo de dependencias\n";
    echo "  dossier <file|all> [project_id] Genera dossier(es) de archivos\n";
    echo "  graph <project_id>              Muestra el grafo de dependencias\n";
    echo "  help                            Muestra esta ayuda\n\n";
    echo "Pipeline completo recomendado:\n";
    echo "  ./bin/lumina analyze ./src 1\n";
    echo "  ./bin/lumina populate 1\n";
    echo "  ./bin/lumina dossier all 1\n\n";
}
