#!/usr/bin/env php
<?php
/**
 * Lumina CLI - Motor de Comprensión de Código
 *
 * Uso:
 *   ./bin/lumina analyze <project_path>
 *   ./bin/lumina dossier <file_path>
 *   ./bin/lumina graph <project_id>
 */

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Lumina\Core\Lumina;
use Lumina\Core\Config;

// Banner
echo "\n";
echo "╔══════════════════════════════════════════╗\n";
echo "║  LUMINA - Motor de Comprensión de Código ║\n";
echo "║  v1.0.0 | Apache 2.0 License              ║\n";
echo "╚══════════════════════════════════════════╝\n\n";

$command = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

$config = Config::load();
$lumina = new Lumina($config);

match ($command) {
    'analyze' => (function() use ($lumina, $args) {
        $path = $args[0] ?? '.';
        $projectId = (int)($args[1] ?? 1);
        $lumina->analyzeProject($path, $projectId);
    })(),
    'dossier' => showComingSoon('dossier', 'Genera el dossier de comprensión de un archivo específico'),
    'graph' => showComingSoon('graph', 'Muestra el grafo de dependencias del proyecto'),
    'help', '--help', '-h' => showHelp(),
    default => showHelp(),
};

/**
 * Muestra mensaje de "Próximamente" para comandos en desarrollo
 */
function showComingSoon(string $command, string $description): void
{
    echo "🚧 Comando '{$command}': Próximamente\n";
    echo "   Descripción: {$description}\n";
    echo "   Estado: En desarrollo (Fase 3+)\n\n";
    echo "   Este comando estará disponible en las próximas fases.\n";
    echo "   Por ahora, solo el comando 'help' está completamente funcional.\n\n";
}

function showHelp(): void
{
    echo "Comandos disponibles:\n\n";
    echo "  analyze <path>    Analiza un proyecto PHP completo [Próximamente]\n";
    echo "  dossier <file>    Genera el dossier de un archivo específico [Próximamente]\n";
    echo "  graph <project>   Muestra el grafo de dependencias [Próximamente]\n";
    echo "  help              Muestra esta ayuda\n\n";
    echo "Ejecuta './bin/lumina <comando> --help' para más información sobre un comando.\n\n";
}
